# Token de la API de football-data.org (registrate en https://www.football-data.org/)
FOOTBALL_API_TOKEN=tu_token_aca

# Conexión a PostgreSQL para uso local/manual (fuera de contenedores)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=football_db
DB_USER=football_user
DB_PASSWORD=football_pass

# Conexión a PostgreSQL para uso dentro de contenedores de Airflow
# En Windows/Mac usar host.docker.internal, en Linux usar la IP del host o el nombre del servicio
FOOTBALL_DB_HOST=localhost
FOOTBALL_DB_PORT=5432
FOOTBALL_DB_NAME=football_db
FOOTBALL_DB_USER=football_user
FOOTBALL_DB_PASSWORD=football_pass

# UID necesario para Airflow en Linux/WSL2
AIRFLOW_UID=50000